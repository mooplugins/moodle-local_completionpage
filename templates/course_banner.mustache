{{!
    @template local_completionpage/course_banner

    Course-page alert linking completed learners to the completion page.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * url - Completion page URL
    * heading - Alert heading
    * message - Supporting message
    * buttonlabel - CTA button label

    Example context (json):
    {
        "url": "https://example.com/local/completionpage/view.php?courseid=2",
        "heading": "Course completed",
        "message": "View your certificate, achievements, and next courses.",
        "buttonlabel": "Open completion page"
    }
}}
<div id="local-completionpage-course-banner" class="local-completionpage-course-banner alert alert-info mb-3" role="status" hidden>
    <div class="local-completionpage-course-banner__inner d-flex flex-wrap justify-content-between gap-3">
        <div class="local-completionpage-course-banner__text min-w-0">
            <div class="local-completionpage-course-banner__heading fw-bold">{{heading}}</div>
            <div class="local-completionpage-course-banner__message">{{message}}</div>
        </div>
        <a class="btn btn-primary local-completionpage-course-banner__btn" href="{{url}}">{{buttonlabel}}</a>
    </div>
</div>
